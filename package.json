{
  "name": "starbox",
  "version": "2.1.260918",
  "description": "StarBox - Emulator ringan multi-layanan",
  "main": "electron-main.js",
  "author": "Gingin Abdul Goni",
  "homepage": "https://starbox.app",
  "scripts": {
    "dev": "NODE_ENV=development node scripts/run-electron.js .",
    "start": "NODE_ENV=production node scripts/run-electron.js .",
    "postinstall": "electron-builder install-app-deps",
    "prebuild": "node update-version.js",
    "prebuild:mac": "node update-version.js",
    "prebuild:win": "node update-version.js",
    "prebuild:linux": "node update-version.js",
    "prebuild:all": "node update-version.js",
    "build:mac": "node ./node_modules/electron-builder/out/cli/cli.js --mac",
    "build:win": "node ./node_modules/electron-builder/out/cli/cli.js --win --arm64 --x64",
    "build:linux": "node ./node_modules/electron-builder/out/cli/cli.js --linux --arm64 --x64",
    "build:all": "npm run build:mac && npm run build:win && npm run build:linux",
    "build": "node ./node_modules/electron-builder/out/cli/cli.js",
    "build:mac:nover": "node ./node_modules/electron-builder/out/cli/cli.js --mac",
    "build:win:nover": "node ./node_modules/electron-builder/out/cli/cli.js --win --arm64 --x64",
    "build:linux:nover": "node ./node_modules/electron-builder/out/cli/cli.js --linux --arm64 --x64",
    "modules:install": "node scripts/modules-install.js",
    "modules:pack": "node scripts/pack-module.js"
  },
  "build": {
    "asar": true,
    "npmRebuild": false,
    "asarUnpack": [
      "package.json"
    ],
    "extraResources": [
      {
        "from": "assets/",
        "to": "assets/",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "node_modules/eventemitter3",
        "to": "app.asar.unpacked/node_modules/eventemitter3"
      },
      {
        "from": "node_modules/p-timeout",
        "to": "app.asar.unpacked/node_modules/p-timeout"
      }
    ],
    "appId": "com.weagate.StarBox",
    "productName": "StarBox",
    "executableName": "StarBox",
    "copyright": "© 2025 Gingin Abdul Goni",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist/**/*",
      "!starbox",
      "!starbox/**/*",
      "!sessions/**/*",
      "!start/**/*",
      "!.DS_Store",
      "!modules/whatsapp-gateway/**/*",
      "!modules/remox/**/*",
      "!modules/mikrotik/**/*",
      "!modules/os-virtual/**/*",
      "!modules/starcapture/**/*",
      "!dist-modules/**/*"
    ],
    "mac": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "assets/starbox.icns",
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "./build/entitlements.mac.plist",
      "entitlementsInherit": "./build/entitlements.mac.inherit.plist",
      "identity": null,
      "asar": true,
      "mergeASARs": false
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/starbox.ico"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/starbox.png",
      "category": "Utility",
      "maintainer": "Gingin Abdul Goni <ginginabdulgoni@gmail.com>",
      "synopsis": "Starbox Emulator untuk multi-service",
      "description": "Starbox adalah emulator desktop ringan untuk menjalankan WhatsApp, Telegram, dan layanan lainnya dalam sesi yang terisolasi."
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": true,
      "createDesktopShortcut": true,
      "shortcutName": "StarBox"
    }
  },
  "devDependencies": {
    "electron": "^25.9.8",
    "electron-builder": "^24.13.3",
    "electron-rebuild": "^3.2.9"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "cron-parser": "^4.9.0",
    "electron-store": "^8.1.0",
    "extract-zip": "^2.0.1",
    "node-machine-id": "^1.1.12",
    "node-window-manager": "^2.2.4",
    "socket.io-client": "^4.8.3",
    "tree-kill": "^1.2.2",
    "uuid": "^9.0.1",
    "ws": "^8.15.0"
  }
}
