{
  "name": "starbox",
  "version": "1.3.251115",
  "description": "StarBox - Emulator ringan multi-layanan",
  "main": "electron-main.js",
  "author": "Gingin Abdul Goni",
  "homepage": "https://starbox.app",
  "scripts": {
    "dev": "NODE_ENV=development ./node_modules/.bin/electron .",
    "start": "NODE_ENV=production ./node_modules/.bin/electron .",
    "postinstall": "node scripts/ensure-cacheable-alias.js && electron-builder install-app-deps",
    "prebuild": "node update-version.js",
    "prebuild:mac": "node update-version.js",
    "prebuild:win": "node update-version.js",
    "prebuild:linux": "node update-version.js",
    "prebuild:all": "node update-version.js",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win --arm64 --x64",
    "build:linux": "electron-builder --linux --arm64 --x64",
    "build:all": "npm run build:mac && npm run build:win && npm run build:linux",
    "build": "electron-builder"
  },
  "build": {
    "asar": true,
    "asarUnpack": [
      "package.json",
      "node_modules/@whiskeysockets/baileys/**",
      "node_modules/@whiskeysockets/baileys/node_modules/**",
      "node_modules/libsignal/**",
      "node_modules/on-exit-leak-free/**",
      "node_modules/protobufjs/**",
      "node_modules/@protobufjs/**",
      "node_modules/long/**",
      "node_modules/@hapi/**",
      "node_modules/async-mutex/**",
      "node_modules/@cacheable/**",
      "node_modules/cacheable/**",
      "node_modules/safe-stable-stringify/**",
      "node_modules/node-cache/**",
      "node_modules/hookified/**",
      "node_modules/p-memoize/**",
      "node_modules/p-cancelable/**",
      "node_modules/p-finally/**",
      "node_modules/p-defer/**",
      "node_modules/p-timeout/**",
      "node_modules/keyv/**",
      "node_modules/@keyv/**",
      "node_modules/@types/**",
      "node_modules/@tokenizer/**",
      "node_modules/@sindresorhus/**",
      "node_modules/@isaacs/**",
      "node_modules/json-buffer/**",
      "node_modules/eventemitter3/**",
      "node_modules/p-queue/**",
      "node_modules/atomic-sleep/**",
      "node_modules/lru-cache/**",
      "node_modules/readable-stream/**",
      "node_modules/music-metadata/**",
      "node_modules/pino/**",
      "node_modules/@pinojs/**",
      "node_modules/ws/**",
      "node_modules/quick-format-unescaped/**",
      "node_modules/curve25519-js/**",
      "node_modules/mime/**",
      "node_modules/file-type/**",
      "node_modules/libphonenumber-js/**",
      "node_modules/qified/**"
    ],
    "extraResources": [
      {
        "from": "assets/",
        "to": "assets/",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "node_modules/eventemitter3",
        "to": "app.asar.unpacked/node_modules/eventemitter3"
      },
      {
        "from": "node_modules/p-timeout",
        "to": "app.asar.unpacked/node_modules/p-timeout"
      }
    ],
    "appId": "com.weagate.StarBox",
    "productName": "StarBox",
    "executableName": "StarBox",
    "copyright": "© 2025 Gingin Abdul Goni",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist/**/*",
      "!sessions/**/*",
      "!repo/**/*",
      "!start/**/*",
      "!.DS_Store"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "assets/starbox.icns",
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "./build/entitlements.mac.plist",
      "entitlementsInherit": "./build/entitlements.mac.inherit.plist",
      "identity": null,
      "asar": false
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/starbox.ico"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/starbox.png",
      "category": "Utility",
      "maintainer": "Gingin Abdul Goni <ginginabdulgoni@gmail.com>",
      "synopsis": "Starbox Emulator untuk multi-service",
      "description": "Starbox adalah emulator desktop ringan untuk menjalankan WhatsApp, Telegram, dan layanan lainnya dalam sesi yang terisolasi."
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": true,
      "createDesktopShortcut": true,
      "shortcutName": "StarBox"
    }
  },
  "devDependencies": {
    "electron": "^25.9.8",
    "electron-builder": "^24.6.0",
    "electron-rebuild": "^3.2.9"
  },
  "dependencies": {
    "@cacheable/node-cache": "^1.7.4",
    "@whiskeysockets/baileys": "^7.0.0-rc.6",
    "adm-zip": "^0.5.16",
    "cron-parser": "^4.9.0",
    "electron-store": "^8.1.0",
    "extract-zip": "^2.0.1",
    "node-machine-id": "^1.1.12",
    "pino": "8.19.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "tree-kill": "^1.2.2",
    "uuid": "^9.0.1",
    "ws": "^8.15.0"
  }
}
