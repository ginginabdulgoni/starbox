    "normalizeAutomationPriority",
    "hasMessagesInProgress",
    "getPersistentMachineId",
    "cleanExpiredMessageCache",
    "buildSystemInfoPayload",
    "buildDeviceSnapshot",
    "getDbPath",
    "getWhatsappMessageCache",
