{
  "id": "android-ios",
  "name": "Android / iOS",
  "version": "1.0.0",
  "description": "Emulator Android (AVD) dengan preset spesifikasi, ADB remote + scrcpy, StarSync multi-device, simulasi SMS/telepon/GPS/kamera, otomasi WhatsApp lewat ADB, dan iOS Simulator (macOS, butuh Xcode).",
  "author": "StarBox",
  "license": "MIT",
  "icon": "bi-phone",
  "engine": {
    "starbox": ">=2.1.0"
  },
  "distribution": "download",
  "main": "main.js",
  "renderer": "renderer.js",
  "page": "page.html",
  "i18n": "i18n.json",
  "pageAfter": [
    "web-emulator"
  ],
  "sidebar": {
    "page": "android-ios",
    "label": "Android / iOS",
    "labelKey": "sidebar.android_ios",
    "icon": "bi-phone",
    "pro": true,
    "after": [
      "web-emulator"
    ],
    "order": 5,
    "statsLabel": "📱 Android / iOS"
  },
  "permissions": [
    "network",
    "child_process",
    "filesystem",
    "dialog",
    "system-install"
  ],
  "sharedDependencies": [
    "uuid"
  ],
  "coreServices": [
    "logDev",
    "sanitizeRemoteServiceId",
    "sanitizeWhatsappVariant",
    "sanitizePendingUrl",
    "getDeviceConfig",
    "updateDeviceStatus",
    "sendAutomationMonitorPayload",
