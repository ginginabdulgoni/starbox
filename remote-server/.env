# Port server WebSocket
PORT=4200

# URL API utama StarBox untuk validasi JWT
STARBOX_API_BASE=http://starbox.test/api

# Path database SQLite audit log
DB_PATH=./data/remote.db

# Timeout command remote (ms)
COMMAND_TIMEOUT_MS=30000

# Interval heartbeat dari client (ms)
HEARTBEAT_INTERVAL_MS=30000

# Ambang dead heartbeat (ms) - client dianggap mati
HEARTBEAT_DEAD_THRESHOLD_MS=75000

# CORS origins (comma-separated, * untuk semua)
CORS_ORIGINS=*

# Feature flag: izinkan command send_js (SANGAT BERBAHAYA - matikan di production)
ALLOW_SEND_JS=false

# Cache validasi token (ms)
TOKEN_CACHE_TTL_MS=60000

# Log level: debug|info|warn|error
LOG_LEVEL=debug

# Mock auth untuk unit test SAJA, matikan di dev/production
# MOCK_AUTH=true
